---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  class: className = '',
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={[
    'anantacast-btn',
    `btn-${variant}`,
    `btn-${size}`,
    className
  ]}
  {...rest}
>
  <slot />
</Tag>

<style>
  .anantacast-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    border: 1px solid transparent;
  }
  .btn-sm {
    padding: 0.4rem 0.9rem;
    font-size: 0.8125rem;
  }
  .btn-md {
    padding: 0.75rem 1.5rem;
    font-size: 0.9375rem;
  }
  .btn-lg {
    padding: 1rem 2rem;
    font-size: 1.0625rem;
  }
  .btn-primary {
    background-color: var(--color-primary-red, #df1001);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(223, 16, 1, 0.25);
  }
  .btn-primary:hover {
    background-color: var(--color-primary-red-hover, #ff2616);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(223, 16, 1, 0.35);
  }
  .btn-secondary {
    background-color: var(--color-surface-subtle, #181615);
    color: #ffffff;
    border-color: var(--color-border-dark, #272523);
  }
  .btn-secondary:hover {
    background-color: #272523;
    border-color: var(--color-border-light, #3e3b38);
  }
  .btn-outline {
    background-color: transparent;
    color: #ffffff;
    border-color: var(--color-border-light, #3e3b38);
  }
  .btn-outline:hover {
    border-color: var(--color-primary-red, #df1001);
    color: var(--color-primary-red, #df1001);
  }
  .btn-ghost {
    background-color: transparent;
    color: var(--color-text-body, #b7bdc2);
  }
  .btn-ghost:hover {
    color: #ffffff;
  }
</style>
