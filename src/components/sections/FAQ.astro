---
interface FAQItem {
  number: string;
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  faqs?: FAQItem[];
}

const defaultFaqs: FAQItem[] = [
  {
    number: '01.',
    question: 'What does AXIOMET actually do?',
    answer: 'AXIOMET helps technology-driven companies solve complex challenges across strategy, engineering, AI, and intelligent systems—from defining the right direction to building scalable solutions.'
  },
  {
    number: '02.',
    question: 'What types of companies do you work with?',
    answer: 'We partner with startups, scale-ups, and established enterprises building technology products, from SaaS platforms to robotics, healthcare systems, and advanced manufacturing operations.'
  },
  {
    number: '03.',
    question: 'Can AXIOMET help us if we only have an idea?',
    answer: 'Yes. Many engagements start with an early concept—we help validate the opportunity, shape the technical direction, and define a practical roadmap before any major investment is made.'
  },
  {
    number: '04.',
    question: 'Do you provide strategy or actual engineering support?',
    answer: 'Both. We define the strategy and architecture, then stay involved through engineering—designing systems, building prototypes, and supporting your team until solutions are production-ready.'
  },
  {
    number: '05.',
    question: 'How do you approach a complex technical problem?',
    answer: 'We start by understanding the real constraints, then break the problem into clear priorities, test assumptions early, and iterate toward a solution that is reliable, scalable, and measurable.'
  },
  {
    number: '06.',
    question: 'What makes AXIOMET different from a traditional consultancy?',
    answer: "We don't stop at recommendations. Our team combines strategy, engineering, and AI expertise to turn decisions into working systems—so the advice you receive is built to be implemented."
  }
];

const {
  eyebrow = 'COMMON QUESTIONS',
  title = 'A few answers to help you understand how we work, where we can help, and what to expect from an AXIOMET engagement.',
  faqs = defaultFaqs
} = Astro.props;
---

<section class="section black-800">
  <div class="section-gap faq">
    <div class="w-layout-blockcontainer container w-container">
      
      <!-- Section Header -->
      <div class="section-header left">
        <div class="section-badge">
          <div class="pill-dot"></div>
          <div class="badge-text">{eyebrow}</div>
        </div>
        <div class="max-width-50">
          <h2 class="section-heading small">{title}</h2>
        </div>
      </div>

      <!-- FAQ Accordion List -->
      <div class="faq-wrapper faq-list">
        {faqs.map((faq, index) => (
          <div data-to-top="0" class="faq-card cursor-pointer">
            <div class="faq-left-main">
              <div class="faq-left">
                <div class="impact-number-wrap faq">
                  <div class="pill-dot"></div>
                  <div class="font-extra-small">{faq.number}</div>
                </div>
              </div>
            </div>
            <div class:list={['faq-right', { last: index === faqs.length - 1 }]}>
              <div class="faq-card-top faq-title-wrap">
                <div class="font-normal">{faq.question}</div>
                <div class="faq-icon-wrap">
                  <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="faq-icon" aria-hidden="true">
                    <path d="M11.9922 4V20M19.9922 12H3.99219" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg>
                </div>
              </div>
              <div class="faq-summary-wrap" style="max-height: 0px; opacity: 0; overflow: hidden; transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);">
                <p class="faq-summary">{faq.answer}</p>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
