---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  eyebrow = 'How we work',
  title = 'From question to solution.',
  description = 'A focused process designed to move complex ideas forward without unnecessary complexity.'
} = Astro.props;
---

<section class="section black-800">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container w-container">
      <div class="section-header center">
        <div class="section-badge">
          <div class="pill-dot"></div>
          <div class="badge-text">{eyebrow}</div>
        </div>
        <div class="max-width-38">
          <h2 class="section-heading small">{title}</h2>
        </div>
        <div class="max-width-28">
          <p class="paragraph-regular">{description}</p>
        </div>
      </div>
      <div class="how-we-work-slider-wrap">
        <div class="how-we-work-grid w-layout-grid">
          
          <div class="how-we-work-card">
            <div class="how-we-work-image-wrap">
              <img
                class="how-we-work-image"
                src="/images/6ace16fc0c98f7df43e99f43_Rectangle%2016.webp"
                alt="Architects collaborating"
                sizes="100vw"
                loading="lazy"
              />
            </div>
            <div class="how-we-work-content">
              <div class="badge-text">01. Discover</div>
              <div class="card-bottom-info">
                <div class="font-medium">Understand the challenge.</div>
                <p class="paragraph-regular">We investigate the business context, technical constraints, users, systems, and opportunities.</p>
              </div>
            </div>
          </div>

          <div class="how-we-work-card">
            <div class="how-we-work-image-wrap">
              <img
                class="how-we-work-image"
                src="/images/6ace16f72c4333ea64724bc2_Rectangle%2016%20(1).webp"
                alt="Strategy session"
                sizes="100vw"
                loading="lazy"
              />
            </div>
            <div class="how-we-work-content">
              <div class="badge-text">02. Define</div>
              <div class="card-bottom-info">
                <div class="font-medium">Find the right direction.</div>
                <p class="paragraph-regular">We turn complexity into clear priorities, technical direction, and an actionable strategy.</p>
              </div>
            </div>
          </div>

          <div class="how-we-work-card">
            <div class="how-we-work-image-wrap">
              <img
                class="how-we-work-image"
                src="/images/6ace16f7e29930062b937251_Rectangle%2016%20(2).webp"
                alt="Engineering systems build"
                sizes="100vw"
                loading="lazy"
              />
            </div>
            <div class="how-we-work-content">
              <div class="badge-text">03. Build</div>
              <div class="card-bottom-info">
                <div class="font-medium">Turn ideas into reality</div>
                <p class="paragraph-regular">We carefully design, engineer, prototype, and develop innovative solutions tailored to real-world needs.</p>
              </div>
            </div>
          </div>

          <div class="how-we-work-card">
            <div class="how-we-work-image-wrap">
              <img
                class="how-we-work-image"
                src="/images/6ace16f242557ef5450ac7d2_Rectangle%2016%20(3).webp"
                alt="Continuous optimization"
                sizes="100vw"
                loading="lazy"
              />
            </div>
            <div class="how-we-work-content">
              <div class="badge-text">04. Optimize</div>
              <div class="card-bottom-info">
                <div class="font-medium">Make it better.</div>
                <p class="paragraph-regular">We continuously measure performance, refine systems, and ensure scalable long-term growth.</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how-we-work-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-top: 3rem;
  }
  @media (max-width: 991px) {
    .how-we-work-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .how-we-work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
