---
---

<section class="section home-hero" style="position: relative; overflow: hidden;">
  <!-- Hero Background Video -->
  <div class="home-hero-video-bg-wrap" style="position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; z-index: 0; pointer-events: none;">
    <video
      autoplay
      loop
      muted
      playsinline
      style="width: 100%; height: 100%; object-fit: cover; opacity: 0.3;"
    >
      <source src="/videos/hero.mp4" type="video/mp4" />
      <source src="/videos/hero.webm" type="video/webm" />
    </video>
    <div style="position: absolute; inset: 0; background: radial-gradient(circle at 70% 30%, rgba(15,13,11,0.2) 0%, rgba(15,13,11,0.85) 75%, #0f0d0b 100%);"></div>
  </div>

  <div class="w-layout-blockcontainer container w-container" style="position: relative; z-index: 1;">
    <div class="home-hero-content-wrap home">
      <div class="home-hero-left">
        <div class="hero-heading-wrap">
          <div class="home-hero-badge">
            <div class="home-hero-pill-group">
              <div class="pill-dot"></div>
              <div class="home-hero-pill-text">Technology</div>
            </div>
            <div class="home-hero-pill-group">
              <div class="pill-dot"></div>
              <div class="home-hero-pill-text">Engineering</div>
            </div>
            <div class="home-hero-pill-group">
              <div class="pill-dot"></div>
              <div class="home-hero-pill-text">Strategy</div>
            </div>
          </div>
          <h1 class="hero-heading">Complex problems. Clear solutions.</h1>
        </div>
        <div class="hero-button-wrap">
          <a
            data-wf--primary-button--variant="bg-white"
            data-wf-component-id="4c762986-7cae-1c12-bec9-1ecbb760ee61"
            data-wf-variant-state="21f200ea-2927-6f93-7fe0-867acd69adf4"
            href="/contact-v1"
            class="primary-button w-variant-21f200ea-2927-6f93-7fe0-867acd69adf4 w-inline-block"
          >
            <div class="button-text-pill">
              <div class="button-text is-one">Start a Project</div>
              <div class="button-text is-two">Start a Project</div>
            </div>
            <div class="button-arrow-pill">
              <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                <path d="M15.8333 12.5002H9.99992H3.33325L3.33325 5.8335V5.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M12.5 16.6668L16.6667 12.5002L12.5 8.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
              <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow">
                <path d="M15.8333 12.5002H9.99992H3.33325L3.33325 5.8335V5.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
                <path d="M12.5 16.6668L16.6667 12.5002L12.5 8.3335" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </div>
          </a>
        </div>
      </div>
      <div class="home-hero-right">
        <div style="position: relative; width: 100%; height: 100%; min-height: 280px; border-radius: 1.25rem; overflow: hidden; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
          <video
            autoplay
            loop
            muted
            playsinline
            style="width: 100%; height: 100%; object-fit: cover; display: block;"
          >
            <source src="/videos/hero.mp4" type="video/mp4" />
            <source src="/videos/hero.webm" type="video/webm" />
          </video>
        </div>
        <div class="home-hero-stats-card">
          <div class="hero-stats-top">
            <div data-counter="counter" class="hero-stats">98.4%</div>
            <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="hero-card-icon">
              <path d="M20 13V8H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M20 8L15 13C14.1174 13.8826 13.6762 14.3238 13.1346 14.3726C13.045 14.3807 12.955 14.3807 12.8654 14.3726C12.3238 14.3238 11.8826 13.8826 11 13C10.1174 12.1174 9.67615 11.6762 9.13457 11.6274C9.04504 11.6193 8.95496 11.6193 8.86543 11.6274C8.32385 11.6762 7.88256 12.1174 7 13L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <div class="font-regular">System Optimization</div>
        </div>
      </div>
    </div>
  </div>
</section>
