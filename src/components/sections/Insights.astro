---
interface Article {
  category: string;
  title: string;
  href: string;
  readTime: string;
}

interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  articles?: Article[];
}

const defaultArticles: Article[] = [
  {
    category: 'Industry Trends',
    title: 'What Comes After Digital Transformation?',
    href: '/blog/what-comes-after-digital-transformation',
    readTime: '6 min read'
  },
  {
    category: 'Engineering',
    title: 'Complexity Is Often a Systems Problem Indeed',
    href: '/blog/complexity-is-often-a-systems-problem-indeed',
    readTime: '8 min read'
  }
];

const {
  eyebrow = 'INSIGHTS & IDEAS',
  title = 'Planning ahead. Getting smarter every day.',
  description = 'Perspectives on technology, engineering, AI, and the decisions shaping what comes next.',
  articles = defaultArticles
} = Astro.props;
---

<section class="section">
  <div class="section-gap">
    <div class="w-layout-blockcontainer container w-container">
      
      <!-- Section Header -->
      <div class="section-header left">
        <div class="section-badge">
          <div class="pill-dot"></div>
          <div class="badge-text">{eyebrow}</div>
        </div>
        <div class="max-width-42">
          <h2 class="section-heading small">{title}</h2>
        </div>
        <div class="max-width-28">
          <p class="paragraph-regular">{description}</p>
        </div>
      </div>

      <!-- Articles Grid -->
      <div class="insights-grid">
        {articles.map((art) => (
          <a href={art.href} class="insight-card group">
            <div class="insight-top">
              <span class="insight-cat">{art.category}</span>
              <span class="insight-time">{art.readTime}</span>
            </div>
            <h3 class="insight-title">{art.title}</h3>
            <div class="insight-cta">
              <span>Read Perspective</span>
              <svg class="insight-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .insights-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-top: 3.5rem;
  }
  .insight-card {
    background-color: var(--color-surface-subtle, #181615);
    border: 1px solid var(--color-border-dark, #272523);
    border-radius: 1.25rem;
    padding: 2.5rem;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 16rem;
    transition: all 0.25s ease;
  }
  .insight-card:hover {
    border-color: var(--color-border-light, #3e3b38);
    transform: translateY(-2px);
    background-color: #1c1a18;
  }
  .insight-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .insight-cat {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-red, #df1001);
    font-weight: 600;
  }
  .insight-time {
    font-size: 0.75rem;
    color: var(--color-text-muted, #8e8e8e);
  }
  .insight-title {
    font-size: 1.625rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.25;
    margin: 0 0 2rem;
  }
  .insight-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-body, #b7bdc2);
    transition: color 0.2s ease;
  }
  .insight-card:hover .insight-cta {
    color: var(--color-primary-red, #df1001);
  }
  .insight-arrow {
    transition: transform 0.2s ease;
  }
  .insight-card:hover .insight-arrow {
    transform: translateX(4px);
  }
  @media (max-width: 767px) {
    .insights-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
