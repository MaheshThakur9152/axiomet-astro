---
import Navigation from './Navigation.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<div
  data-animation="default"
  class="navber w-nav"
  data-easing2="ease"
  data-easing="ease"
  data-collapse="all"
  role="banner"
  data-duration="600"
>
  <div class="container w-container">
    <div class="nav-item-wrap">
      
      <!-- Brand Logo -->
      <a href="/" aria-current={currentPath === '/' ? 'page' : undefined} class:list={['w-nav-brand', { 'w--current': currentPath === '/' }]}>
        <img
          loading="lazy"
          src="/images/image__1_-removebg-preview.svg"
          alt="Anantacast logo"
          class="brand-logo"
          style="max-height: 48px; width: auto;"
        />
      </a>

      <!-- Navigation Dropdown Panel -->
      <Navigation currentPath={currentPath} />

      <!-- Menu Button -->
      <div class="nav-right">
        <div class="menu-button w-nav-button" role="button" tabindex="0" aria-label="menu" aria-haspopup="menu" aria-expanded="false">
          <div class="div-block">
            <div class="menu-dots">
              <div class="menu-dot"></div>
              <div class="menu-dot"></div>
              <div class="menu-dot"></div>
              <div class="menu-dot"></div>
            </div>
            <div class="menu-text-wrap">
              <div class="nav-menu-text">Menu</div>
              <div class="menu-minus"></div>
            </div>
          </div>
          <div class="menu-blur"></div>
        </div>
      </div>

    </div>
  </div>
</div>
