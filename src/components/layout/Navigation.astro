---
interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;
---

<nav role="navigation" class="nav-menu w-nav-menu">
  <div class="nav-menu-panel">
    <div class="navigation-var-main">
      <div class="nav-menu-left">
        <div class="nav-menu-wrapper">
          <div class="nav-menu-group">
            <div class="menu-text">Main pages</div>
            <div class="nav-menu-main">
              <a href="/" class:list={['nav-link', { 'w--current': currentPath === '/' }]}>Home V1</a>
              <a href="/home-v2" class:list={['nav-link', { 'w--current': currentPath === '/home-v2' }]}>Home V2</a>
              <a href="/home-v3" class:list={['nav-link', { 'w--current': currentPath === '/home-v3' }]}>Home V3</a>
              <a href="/case-study-v1" class:list={['nav-link', { 'w--current': currentPath === '/case-study-v1' }]}>Case Studies V1</a>
              <a href="/case-study-v2" class:list={['nav-link', { 'w--current': currentPath === '/case-study-v2' }]}>Case Studies V2</a>
              <a href="/case-study-v3" class:list={['nav-link', { 'w--current': currentPath === '/case-study-v3' }]}>Case Studies V3</a>
            </div>
          </div>
          <div class="nav-menu-group">
            <div class="menu-text">Single pages</div>
            <div class="nav-menu-main">
              <a href="/about-us" class:list={['nav-link', { 'w--current': currentPath === '/about-us' }]}>About</a>
              <a href="/service" class:list={['nav-link', { 'w--current': currentPath === '/service' }]}>Service</a>
              <a href="/blog" class:list={['nav-link', { 'w--current': currentPath === '/blog' }]}>Blog</a>
              <a href="/contact-v1" class:list={['nav-link', { 'w--current': currentPath === '/contact-v1' }]}>Contact V1</a>
              <a href="/contact-v2" class:list={['nav-link', { 'w--current': currentPath === '/contact-v2' }]}>Contact V2</a>
              <a href="/contact-v3" class:list={['nav-link', { 'w--current': currentPath === '/contact-v3' }]}>Contact V3</a>
            </div>
          </div>
          <div class="nav-menu-group">
            <div class="menu-text">Utility Pages</div>
            <div class="nav-menu-main">
              <a href="/style-guide" class:list={['nav-link', { 'w--current': currentPath === '/style-guide' }]}>Style Guide</a>
              <a href="/licenses" class:list={['nav-link', { 'w--current': currentPath === '/licenses' }]}>License</a>
              <a href="/changelog" class:list={['nav-link', { 'w--current': currentPath === '/changelog' }]}>Change Log</a>
              <a href="/404" class:list={['nav-link', { 'w--current': currentPath === '/404' }]}>404</a>
            </div>
          </div>
        </div>
        <div class="dropdown-menu-line"></div>
        <div class="nav-left-bottom"></div>
      </div>
      <div class="nav-menu-right">
        <div class="dropdown-right-top">
          <a href="/" class="dropdown-brand-link w-inline-block">
            <img
              src="/images/image__1_-removebg-preview.svg"
              loading="lazy"
              alt="Anantacast logo"
              class="menu-brand-logo"
              style="max-height: 40px; width: auto;"
            />
          </a>
          <div class="menu-description">High-Tech Consulting &amp; Engineering</div>
          <a href="/contact-v1" class="btn right w-inline-block">
            <div>Contact Us</div>
          </a>
        </div>
        <img
          src="/images/6ac88e003ea9e2ed4ed9d3e9_Home%20(1).webp"
          loading="lazy"
          sizes="100vw"
          alt="Two men in business attire looking at a laptop screen together in a modern office"
          class="menu-right-image"
        />
      </div>
    </div>
  </div>
</nav>
