---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title = 'Anantacast - Complex problems. Clear solutions.',
  description = 'Turning complex technology challenges into measurable progress, stronger systems, and lasting business impact.',
  ogImage = '/images/6ace2fd4032dc020d326331a_eea90ebed600dcaaf93d357b1fbaf60e_open%20graph%20image%20%281200x630%29.webp',
  hideHeader = false,
  hideFooter = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://axiomet.consulting');
const fullTitle = title.includes('Anantacast') ? title : `${title} | Anantacast`;
---

<!doctype html>
<html lang="en" class="w-mod-js w-mod-ix">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts Preconnect & Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#0f0d0b] text-[#f8f9fa]">
    <div class="page-wrapper">
      {!hideHeader && <Header />}
      <slot />
      {!hideFooter && <Footer />}
    </div>

    <!-- Animation & Webflow Interaction Libraries (Local) -->
    <script is:inline src="/js/jquery.min.js"></script>
    <script is:inline src="/js/gsap.min.js"></script>
    <script is:inline src="/js/ScrollTrigger.min.js"></script>
    <script is:inline src="/js/SplitText.min.js"></script>
    <script is:inline src="/js/webflow.chunk1.js"></script>
    <script is:inline src="/js/webflow.chunk2.js"></script>
    <script is:inline src="/js/webflow.main.js"></script>

    <!-- Client-side navigation & interactions -->
    <script src="../scripts/navigation.ts"></script>
    <script src="../scripts/interactions.ts"></script>
  </body>
</html>
