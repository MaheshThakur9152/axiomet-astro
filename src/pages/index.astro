---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Features from '../components/sections/Features.astro';
import Industries from '../components/sections/Industries.astro';
import CaseStudies from '../components/sections/CaseStudies.astro';
import Impact from '../components/sections/Impact.astro';
import Process from '../components/sections/Process.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import Insights from '../components/sections/Insights.astro';
import FAQ from '../components/sections/FAQ.astro';
import LogosMarquee from '../components/sections/LogosMarquee.astro';
import Contact from '../components/sections/Contact.astro';
---

<BaseLayout
  title="Anantacast - Complex problems. Clear solutions."
  description="Turning complex technology challenges into measurable progress, stronger systems, and lasting business impact."
  hideHeader={true}
>
  <div class="home-hero-area">
    <!-- Hero Background Video: covers entire hero section edge-to-edge behind header -->
    <div class="home-hero-video w-background-video w-background-video-atom" style="position: absolute; inset: 0; width: 100%; height: 100%; overflow: hidden; z-index: 0; pointer-events: none;">
      <video
        id="home-hero-video-bg"
        autoplay
        loop
        muted
        playsinline
        data-wf-ignore="true"
        data-object-fit="cover"
        style="width: 100%; height: 100%; object-fit: cover; opacity: 0.9;"
      >
        <source src="/videos/hero.mp4" type="video/mp4" data-wf-ignore="true" />
        <source src="/videos/hero.webm" type="video/webm" data-wf-ignore="true" />
      </video>
    </div>
    <div class="hero-overlay-top"></div>
    <div class="hero-overlay-bottom"></div>

    <!-- Header floating seamlessly at the top of the hero video -->
    <Header currentPath="/" />

    <!-- Hero Content -->
    <Hero />
  </div>

  <About />
  <Features />
  <Industries />
  <CaseStudies />
  <Impact />
  <Process />
  <Testimonials />
  <Insights />
  <FAQ />
  <LogosMarquee />
  <Contact />
</BaseLayout>
