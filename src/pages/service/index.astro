---
import BaseLayout from '@/layouts/BaseLayout.astro';
import pagesData from '@/data/pages_html.json';

const pageKey = 'service';
const htmlContent = (pagesData as Record<string, string>)[pageKey] || '';
---

<BaseLayout
  title="Services | Axiomet"
  description="Turning Complex Challenges Into Clear Solutions."
>
  <div class="webflow-content overflow-hidden" set:html={htmlContent} />
</BaseLayout>
