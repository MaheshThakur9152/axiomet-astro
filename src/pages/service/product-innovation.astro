---
import BaseLayout from '@/layouts/BaseLayout.astro';
import pagesData from '@/data/pages_html.json';

const pageKey = 'service-product-innovation';
const htmlContent = (pagesData as Record<string, string>)[pageKey] || '';
---

<BaseLayout
  title="Product & Innovation Services | Axiomet"
  description="Rapid validation, user prototyping, market launch."
>
  <div class="webflow-content overflow-hidden" set:html={htmlContent} />
</BaseLayout>
