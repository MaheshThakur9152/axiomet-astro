"1.5" stroke-linecap="round"></path><path d="M14 2.20004C13.3538 2.06886 12.6849 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 11.3151 21.9311 10.6462 21.8 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path><path d="M12.0312 11.9624L16.5842 7.40949M19.7414 4.34451L19.1882 2.35737C19.0863 2.03 18.6923 1.89954 18.4268 2.11651C16.9907 3.29007 15.4263 4.8708 16.7039 7.36408C19.278 8.56444 20.7476 6.94573 21.8743 5.58519C22.0985 5.31449 21.9633 4.90756 21.6257 4.80994L19.7414 4.34451Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></div><div class="about-card-info-wrap help"><h3 class="font-extra-normal help">Strategy before execution</h3><p class="font-small help">We ask why before how, and tie every decision to real business outcomes.</p></div></div><div data-to-top="4" class="about-stats-card about-principle"><div class="about-icon-wrap case-v2"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" width="100%" class="about-card-icon v2"><path d="M20 10C19.9641 7.52043 19.7801 6.11466 18.8365 5.17157C17.6643 4 15.7776 4 12.0043 4C8.23106 4 6.34442 4 5.17221 5.17157C4 6.34315 4 8.22876 4 12C4 15.7712 4 17.6569 5.17221 18.8284C6.23545 19.8911 7.88646 19.9899 11 19.9991" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path><path d="M18 19.7143V21M18 19.7143C16.8432 19.7143 15.8241 19.1461 15.2263 18.2833M18 19.7143C19.1568 19.7143 20.1759 19.1461 20.7737 18.2833M15.2263 18.2833L14.0004 19.0714M18 13.2857C16.8431 13.2857 15.8239 13.854 15.2262 14.7169C14.8727 15.2271 14.6667 15.8403 14.6667 16.5C14.6667 17.1597 14.8728 17.773 15.2263 18.2833M20.7737 18.2833L21.9996 19.0714M18 13.2857C19.1569 13.2857 20.1761 13.854 20.7738 14.7169C21.1273 15.2271 21.3333 15.8403 21.3333 16.5C21.3333 17.1597 21.1272 17.773 20.7737 18.2833M18 13.2857V12M20.7738 14.7169L22 13.9286M15.2262 14.7169L14 13.9286" stro