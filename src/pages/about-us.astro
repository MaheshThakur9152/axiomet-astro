---
import BaseLayout from '@/layouts/BaseLayout.astro';
import pagesData from '@/data/pages_html.json';

const pageKey = 'about-us';
const htmlContent = (pagesData as Record<string, string>)[pageKey] || '';
---

<BaseLayout
  title="About Us | Axiomet"
  description="Building clarity into complex technology."
>
  <div class="webflow-content overflow-hidden" set:html={htmlContent} />
</BaseLayout>
