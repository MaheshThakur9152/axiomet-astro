---
import BaseLayout from '@/layouts/BaseLayout.astro';
import pagesData from '@/data/pages_html.json';

const pageKey = '404';
const htmlContent = (pagesData as Record<string, string>)[pageKey] || '';
---

<BaseLayout
  title="404 - Page Not Found | Axiomet"
  description="The page you are looking for does not exist."
>
  <div class="webflow-content overflow-hidden" set:html={htmlContent} />
</BaseLayout>
