 Email" data-name="Work Email" placeholder="you@company.com" type="email" id="work-email" required=""/></div><div class="contact-form-field"><label for="company" class="contact-form-label">Company</label><input class="contact-form-input w-input" maxlength="256" name="Company" data-name="Company" placeholder="Company name" type="text" id="company"/></div><div class="contact-form-field"><label for="" class="contact-form-label">Project Type</label><div class="contact-select-wrap"><select id="project-type" name="Project Type" data-name="Project Type" required="" class="contact-form-input select w-select"><option value="">Select a project type</option><option value="Technology Strategy">Technology Strategy</option><option value="Systems &amp; Product Engineering">Systems </option><option value="AI &amp; Intelligent Systems">AI </option><option value="Product &amp; Innovation">Product </option><option value="Other">Other</option></select><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="none" width="100%" class="contact-select-icon"><path d="M5.66667 7.99951L9.83333 12.1662L14 7.99951" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div><div class="contact-form-field"><label for="" class="contact-form-label">Message</label><textarea required="" placeholder="What are you trying to build, solve, or improve?" maxlength="5000" id="message" name="Message" data-name="Message" class="contact-form-input textarea w-input"></textarea></div><div class="font-small">We’ll review your message and get back to you within 1–2 business days.</div></div><div class="contact-submit-wrap"><input type="submit" data-wait="Please wait..." class="primary-button contact-submit w-button" value="Send Project Inquiry"/><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none" class="button-arrow contact-submit"><path d="M15.8333 12.5002H9.99992H3.33325L3.33325 5.8335V5.3335" stroke="currentColor" st